# MongoDB Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=aiconsultant

# OpenRouter API keys (comma-separated)
OPENROUTER_API_KEYS=your_openrouter_key_1,your_openrouter_key_2

# Groq API keys (comma-separated)
GROQ_API_KEYS=your_groq_key_1,your_groq_key_2

# Google AI Studio Gemini API key
GOOGLE_GEMINI_API_KEY=your_gemini_key

# Gamma API key (for PowerPoint generation)
GAMMA_API_KEY=your_gamma_key

# Enable health checks
ENABLE_HEALTH_CHECK=true
